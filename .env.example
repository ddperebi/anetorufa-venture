# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OWNER_NOTIFICATION_EMAIL: Real email address of the business owner of Anetorufa Ventures.
# Enter the business owner's email here to receive all incoming customer form enquiries.
# Example: owner@anetorufaventures.com or ddperebi@gmail.com
OWNER_NOTIFICATION_EMAIL=""

# RESEND_API_KEY: (Optional) API key from https://resend.com to deliver email alerts to the owner.
# If not provided, incoming enquiries are safely saved to data/messages.json with full audit trail.
RESEND_API_KEY=""

# NOTIFICATION_FROM_EMAIL: (Optional) Verified sender address for transactional delivery (defaults to onboarding@resend.dev)
NOTIFICATION_FROM_EMAIL="onboarding@resend.dev"

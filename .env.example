# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FORMSPREE_ENDPOINT: Formspree endpoint where all website form submissions (Contact Enquiries & Book Goods Orders) are forwarded.
# Provided endpoint:
FORMSPREE_ENDPOINT="https://formspree.io/f/xrpejnno"

# OWNER_NOTIFICATION_EMAIL: Real email address of the business owner of Anetorufa Ventures.
# Example: ddperebi@gmail.com
OWNER_NOTIFICATION_EMAIL="ddperebi@gmail.com"

# RESEND_API_KEY: (Optional) Secondary transactional email API key from https://resend.com
RESEND_API_KEY=""

# NOTIFICATION_FROM_EMAIL: (Optional) Verified sender address for transactional delivery (defaults to onboarding@resend.dev)
NOTIFICATION_FROM_EMAIL="onboarding@resend.dev"

